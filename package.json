{
  "name": "locked-browser",
  "version": "1.0.0",
  "description": "Minimal locked-down Chromium browser. Only title bar, locks to URL from config.json. Hotkeys: F11 fullscreen, F12 screenshot.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "author": "Weavin-boy",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.weavin.lockedbrowser",
    "productName": "Locked Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "config.json",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
