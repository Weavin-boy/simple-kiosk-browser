{
  "name": "simple-kiosk-browser",
  "version": "1.0.3a",
  "description": "Minimal locked-down Chromium browser. Only title bar, locks to URL from config.json. Hotkeys: F11 fullscreen, F12 screenshot. Ctrl/Alt/Shift, clipboard, and pointer lock enabled.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win dir --publish never"
  },
  "author": "Weavin-boy",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.weavin.simplekioskbrowser",
    "productName": "Simple Kiosk Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "publish": null,
    "win": {
      "target": "dir",
      "icon": null
    }
  }
}
